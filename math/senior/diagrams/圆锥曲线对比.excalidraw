      "x": 320,
      "y": 270,
      "text": "||PF₁|−|PF₂||=2a\ne = c/a > 1\nc² = a² + b²",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#495057",
      "originalText": "||PF₁|−|PF₂||=2a\ne = c/a > 1\nc² = a² + b²",
